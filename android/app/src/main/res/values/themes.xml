<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Must be AppCompat descendant — AppCompatActivity crashes with platform Theme.NoTitleBar -->
    <style name="Theme.Athuex" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorPrimary">#76B900</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#76B900</item>
    </style>
</resources>
